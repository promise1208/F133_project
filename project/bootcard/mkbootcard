#!/bin/bash
if [[ "${BASH_SOURCE[0]}" != "$0" && \
	"${MKBOOTCARD_TEST_SOURCE:-}" != "1" ]]; then
	return 0
fi

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
KERNEL_RELEASE=5.4.61
SECTOR_SIZE=512
ROOTFS_START_SECTOR=8192
ROOTFS_FREE_BYTES=$((64 * 1024 * 1024))
MAX_INTEGER=9223372036854775807

BOOTLOADER="$SCRIPT_DIR/boot0_sdcard.fex"
OPENSBI="$SCRIPT_DIR/fw_jump.bin"
EARLY_DTB="$SCRIPT_DIR/dawn-d1s-uboot.dtb"
UBOOT="$SCRIPT_DIR/u-boot-nodtb.bin"
KERNEL="$SCRIPT_DIR/Image"
DTB="$SCRIPT_DIR/dawn_d1s.dtb"
ROOTFS="$SCRIPT_DIR/dawn_d1s_rootfs"
MODULE="$ROOTFS/lib/modules/$KERNEL_RELEASE/extra/dawn_bmp280.ko"
ROOTFS_REAL=
ROOTFS_RESOLVED=
RESOLVED_MODULE=
SCAN_DIR=
STAGE_DIR=
FLASH_BOOTLOADER=
FLASH_OPENSBI=
FLASH_EARLY_DTB=
FLASH_UBOOT=

cleanup()
{
	if [[ -n "$SCAN_DIR" && -d "$SCAN_DIR" ]]; then
		rm -rf -- "$SCAN_DIR"
	fi
	if [[ -n "$STAGE_DIR" && -d "$STAGE_DIR" ]]; then
		rm -rf -- "$STAGE_DIR"
	fi
}

die()
{
	printf 'Error: %s\n' "$*" >&2
	exit 1
}

require_file()
{
	local path=$1

	if [[ ! -f "$path" ]]; then
		die "$path: missing"
	fi
	if [[ ! -s "$path" ]]; then
		die "$path: empty"
	fi
}

require_flash_tools()
{
	local tool

	for tool in cp dd du fdisk lsblk mkfs.ext4 readlink stat sync \
		udevadm; do
		if ! command -v "$tool" >/dev/null 2>&1; then
			die "$tool: missing command"
		fi
	done
}

require_supported_integer()
{
	local value=$1
	local report=$2
	local high_digit
	local low_digits

	if [[ ! "$value" =~ ^[0-9]+$ || \
		("${#value}" -gt 1 && "$value" == 0*) ]]; then
		die "$report: invalid integer"
	fi
	if ((${#value} > 19)); then
		die "$report: exceeds supported range"
	fi
	if ((${#value} == 19)); then
		high_digit=${value:0:1}
		low_digits=${value:1}
		if ((high_digit == 9 && \
			10#$low_digits > 223372036854775807)); then
			die "$report: exceeds supported range"
		fi
	fi
}

require_boot_region()
{
	local path=$1
	local start_sector=$2
	local limit_sector=$3
	local limit_name=$4
	local size
	local available_sectors
	local available_bytes

	if ! size="$(stat -c %s -- "$path")"; then
		die "$path: unable to query size"
	fi
	require_supported_integer "$size" "$path: size"
	if ((size == 0)); then
		die "$path: empty"
	fi
	available_sectors=$((limit_sector - start_sector))
	available_bytes=$((available_sectors * SECTOR_SIZE))
	if ((size > available_bytes)); then
		die "$path: overlaps $limit_name at sector $limit_sector"
	fi
}

require_boot_regions()
{
	local bootloader=${1:-$BOOTLOADER}
	local opensbi=${2:-$OPENSBI}
	local early_dtb=${3:-$EARLY_DTB}
	local uboot=${4:-$UBOOT}

	require_boot_region "$bootloader" 16 200 "OpenSBI region"
	require_boot_region "$opensbi" 200 500 "early DTB region"
	require_boot_region "$early_dtb" 500 600 "U-Boot region"
	require_boot_region "$uboot" 600 "$ROOTFS_START_SECTOR" \
		"rootfs partition"
}

stage_boot_artifacts()
{
	if ! STAGE_DIR="$(mktemp -d '/tmp/mkbootcard-stage.XXXXXX')"; then
		die "unable to create boot artifact stage directory"
	fi
	FLASH_BOOTLOADER="$STAGE_DIR/boot0_sdcard.fex"
	FLASH_OPENSBI="$STAGE_DIR/fw_jump.bin"
	FLASH_EARLY_DTB="$STAGE_DIR/dawn-d1s-uboot.dtb"
	FLASH_UBOOT="$STAGE_DIR/u-boot-nodtb.bin"
	cp -- "$BOOTLOADER" "$FLASH_BOOTLOADER"
	cp -- "$OPENSBI" "$FLASH_OPENSBI"
	cp -- "$EARLY_DTB" "$FLASH_EARLY_DTB"
	cp -- "$UBOOT" "$FLASH_UBOOT"
	require_boot_regions "$FLASH_BOOTLOADER" "$FLASH_OPENSBI" \
		"$FLASH_EARLY_DTB" "$FLASH_UBOOT"
}

require_unmounted_device()
{
	local device=$1
	local mountpoints

	if ! mountpoints="$(lsblk -nrpo MOUNTPOINT -- "$device")"; then
		die "$device: unable to query mounted filesystems"
	fi
	if [[ -n "${mountpoints//[[:space:]]/}" ]]; then
		die "$device: has mounted filesystems"
	fi
}

require_no_active_swap()
{
	local device=$1
	local swaps_file=${2:-/proc/swaps}
	local descendants
	local swap_path
	local swap_real
	local ignored
	local descendant
	local descendant_real

	if [[ ! -r "$swaps_file" ]]; then
		die "$swaps_file: unable to read active swaps"
	fi
	if ! descendants="$(lsblk -nrpo NAME -- "$device")"; then
		die "$device: unable to query descendant devices"
	fi
	while read -r swap_path ignored; do
		if [[ -z "$swap_path" || "$swap_path" == "Filename" ]]; then
			continue
		fi
		if ! swap_real="$(readlink -f -- "$swap_path" 2>/dev/null)"; then
			swap_real=$swap_path
		fi
		while IFS= read -r descendant; do
			if ! descendant_real="$(readlink -f -- \
				"$descendant" 2>/dev/null)"; then
				descendant_real=$descendant
			fi
			if [[ "$swap_real" == "$descendant_real" ]]; then
				die "$device: descendant $swap_path is active swap"
			fi
		done <<< "$descendants"
	done < "$swaps_file"
}

require_device_capacity()
{
	local device=$1
	local device_size
	local rootfs_output
	local rootfs_size
	local kernel_size
	local dtb_size
	local required_size
	local component

	if ! device_size="$(lsblk -bdnro SIZE -- "$device")"; then
		die "$device: unable to query capacity"
	fi
	require_supported_integer "$device_size" "$device: capacity"
	if ! rootfs_output="$(du -sb -- "$ROOTFS_REAL")"; then
		die "$ROOTFS_REAL: unable to query size"
	fi
	rootfs_size=${rootfs_output%%[[:space:]]*}
	require_supported_integer "$rootfs_size" "$device: required capacity"
	if ! kernel_size="$(stat -c %s -- "$KERNEL")" || \
		! dtb_size="$(stat -c %s -- "$DTB")"; then
		die "unable to query kernel or DTB size"
	fi
	require_supported_integer "$kernel_size" "$device: required capacity"
	require_supported_integer "$dtb_size" "$device: required capacity"
	required_size=$((ROOTFS_START_SECTOR * SECTOR_SIZE))
	for component in "$rootfs_size" "$kernel_size" "$dtb_size" \
		"$ROOTFS_FREE_BYTES"; do
		if ((component > MAX_INTEGER - required_size)); then
			die "$device: required capacity exceeds supported range"
		fi
		required_size=$((required_size + component))
	done
	if ((device_size < required_size)); then
		die "$device: insufficient capacity (need $required_size bytes)"
	fi
}

require_elf()
{
	local path=$1
	local report_path=${2:-$path}
	local magic

	if [[ ! -f "$path" ]]; then
		die "$report_path: missing"
	fi

	magic="$(od -An -tx1 -N4 "$path" | tr -d '[:space:]')"
	if [[ "$magic" != "7f454c46" ]]; then
		die "$report_path: invalid ELF magic"
	fi
}

resolve_rootfs_leaf()
{
	local path=$1
	local link_target
	local containing_dir
	local mapped_path

	if [[ -L "$path" ]]; then
		if ! link_target="$(readlink -- "$path")"; then
			die "$path: unable to read symlink"
		fi
		if [[ "$link_target" == /* ]]; then
			mapped_path="$ROOTFS_REAL$link_target"
		else
			if ! containing_dir="$(readlink -f -- "$(dirname -- \
				"$path")")"; then
				die "$path: unable to resolve containing directory"
			fi
			mapped_path="$containing_dir/$link_target"
		fi
	else
		mapped_path=$path
	fi

	if ! ROOTFS_RESOLVED="$(readlink -m -- "$mapped_path")"; then
		die "$path: unable to resolve rootfs path"
	fi
	if [[ "$ROOTFS_RESOLVED" != "$ROOTFS_REAL" && \
		"$ROOTFS_RESOLVED" != "$ROOTFS_REAL/"* ]]; then
		die "$path: escapes rootfs"
	fi
}

require_rootfs_elf()
{
	local path=$1

	resolve_rootfs_leaf "$path"
	if [[ ! -f "$ROOTFS_RESOLVED" ]]; then
		die "$path: missing"
	fi
	if [[ ! -s "$ROOTFS_RESOLVED" ]]; then
		die "$path: empty"
	fi
	require_elf "$ROOTFS_RESOLVED" "$path"
}

preflight()
{
	local library
	local destination
	local aliases
	local vermagic
	local module_alias
	local alias_found
	local link_target
	local link_path
	local resolved_link

	require_file "$BOOTLOADER"
	require_file "$OPENSBI"
	require_file "$EARLY_DTB"
	require_file "$UBOOT"
	require_file "$KERNEL"
	require_file "$DTB"
	require_boot_regions

	if [[ ! -d "$ROOTFS" ]]; then
		die "$ROOTFS: missing directory"
	fi
	if ! ROOTFS_REAL="$(readlink -f -- "$ROOTFS")"; then
		die "$ROOTFS: unable to canonicalize rootfs"
	fi
	if [[ ! -d "$ROOTFS_REAL" ]]; then
		die "$ROOTFS: missing directory"
	fi
	for library in "$ROOTFS_REAL/sbin" "$ROOTFS_REAL/lib" \
		"$ROOTFS_REAL/lib/modules" \
		"$ROOTFS_REAL/lib/modules/$KERNEL_RELEASE" \
		"$ROOTFS_REAL/lib/modules/$KERNEL_RELEASE/extra"; do
		if [[ ! -d "$library" || -L "$library" ]]; then
			die "$library: missing directory"
		fi
	done
	for destination in "$ROOTFS/Image" "$ROOTFS/dawn_d1s.dtb"; do
		if [[ -L "$destination" ]]; then
			die "$destination: destination must not be symlink"
		fi
	done

	require_rootfs_elf "$ROOTFS/sbin/init"
	require_rootfs_elf "$ROOTFS/lib/ld-2.29.so"
	require_rootfs_elf "$ROOTFS/lib/libc-2.29.so"
	require_rootfs_elf "$MODULE"
	RESOLVED_MODULE=$ROOTFS_RESOLVED

	if ! SCAN_DIR="$(mktemp -d '/tmp/mkbootcard-scan.XXXXXX')"; then
		die "unable to create scan directory"
	fi

	if ! find "$ROOTFS/lib" -mindepth 1 -maxdepth 1 -type l -print0 \
		> "$SCAN_DIR/lib-symlinks"; then
		die "$ROOTFS/lib: unable to scan symlinks"
	fi
	while IFS= read -r -d '' library; do
		if ! link_target="$(readlink -- "$library")"; then
			die "$library: unable to read symlink"
		fi
		if [[ "$link_target" == /* ]]; then
			link_path="$ROOTFS_REAL$link_target"
		else
			link_path="$ROOTFS_REAL/lib/$link_target"
		fi
		if ! resolved_link="$(readlink -m -- "$link_path")"; then
			die "$library: unable to resolve symlink"
		fi
		if [[ "$resolved_link" != "$ROOTFS_REAL" && \
			"$resolved_link" != "$ROOTFS_REAL/"* ]]; then
			die "$library: symlink escapes rootfs"
		fi
		if [[ ! -e "$resolved_link" ]]; then
			die "$library: broken symlink"
		fi
	done < "$SCAN_DIR/lib-symlinks"

	if ! find "$ROOTFS/lib" -mindepth 1 -maxdepth 1 -type f \
		-name '*.so*' ! -name '*.py' -print0 > "$SCAN_DIR/lib-files"; then
		die "$ROOTFS/lib: unable to scan libraries"
	fi
	while IFS= read -r -d '' library; do
		require_elf "$library"
	done < "$SCAN_DIR/lib-files"

	if ! vermagic="$(modinfo -F vermagic "$RESOLVED_MODULE" 2>/dev/null)"; then
		die "$MODULE: modinfo failed"
	fi
	if [[ "$vermagic" != "$KERNEL_RELEASE "* ]]; then
		die "$MODULE: invalid vermagic"
	fi

	if ! aliases="$(modinfo -F alias "$RESOLVED_MODULE" 2>/dev/null)"; then
		die "$MODULE: modinfo failed"
	fi
	alias_found=false
	while IFS= read -r module_alias; do
		if [[ "$module_alias" == "i2c:dawn_bmp280" ]]; then
			alias_found=true
			break
		fi
	done <<< "$aliases"
	if [[ "$alias_found" != true ]]; then
		die "$MODULE: missing alias i2c:dawn_bmp280"
	fi

	if ! rm -rf -- "$SCAN_DIR"; then
		die "$SCAN_DIR: unable to clean scan directory"
	fi
	SCAN_DIR=
}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
	return 0
fi

trap cleanup EXIT

if [[ "$#" -ne 1 ]]; then
	die "usage: $0 [--check-only|target]"
fi

if [[ "$1" == "--check-only" ]]; then
	preflight
	printf 'Preflight successful\n'
	exit 0
fi

TARGET="$1"
preflight
require_flash_tools

if ! SD_DEV="$(readlink -f -- "$TARGET")"; then
	die "$TARGET: unable to canonicalize target"
fi
if [[ ! -b "$SD_DEV" ]]; then
	die "$SD_DEV: not a block device"
fi

if ! DEVICE_TYPE="$(lsblk -dnro TYPE -- "$SD_DEV")"; then
	die "$SD_DEV: unable to query lsblk TYPE"
fi
if [[ "$DEVICE_TYPE" != "disk" ]]; then
	die "$SD_DEV: lsblk TYPE is not disk"
fi

if ! REMOVABLE="$(lsblk -dnro RM -- "$SD_DEV")"; then
	die "$SD_DEV: unable to query lsblk RM"
fi
if [[ "$REMOVABLE" != "1" ]]; then
	die "$SD_DEV: is not a removable disk"
fi

require_unmounted_device "$SD_DEV"
require_no_active_swap "$SD_DEV"
require_device_capacity "$SD_DEV"

if [[ "$SD_DEV" =~ [0-9]$ ]]; then
	ROOTFS_PART="${SD_DEV}p1"
else
	ROOTFS_PART="${SD_DEV}1"
fi

cp "$KERNEL" "$ROOTFS"
cp "$DTB" "$ROOTFS"
stage_boot_artifacts

require_unmounted_device "$SD_DEV"
require_no_active_swap "$SD_DEV"

printf 'Creating image file %s...\n' "$SD_DEV"
dd if="/dev/zero" of="$SD_DEV" bs=1M count=4
sync
printf 'Creating partitions...\n'
(
	echo o
	echo n
	echo p
	echo 1
	echo 8192
	echo
	echo w
) | fdisk -- "$SD_DEV"
sync

if ! udevadm settle; then
	die "unable to settle udev"
fi
if [[ ! -b "$ROOTFS_PART" ]]; then
	die "$ROOTFS_PART: partition not found after fdisk"
fi
if ! PARTITION_TYPE="$(lsblk -dnro TYPE -- "$ROOTFS_PART")"; then
	die "$ROOTFS_PART: unable to query lsblk TYPE"
fi
if [[ "$PARTITION_TYPE" != "part" ]]; then
	die "$ROOTFS_PART: lsblk TYPE is not part"
fi
if ! PARENT_NAME="$(lsblk -dnro PKNAME -- "$ROOTFS_PART")"; then
	die "$ROOTFS_PART: unable to query lsblk PKNAME"
fi
if [[ -z "$PARENT_NAME" ]]; then
	die "$ROOTFS_PART: missing parent disk"
fi
if ! PARENT_DEV="$(readlink -f -- "/dev/$PARENT_NAME")"; then
	die "$ROOTFS_PART: unable to resolve parent disk"
fi
if [[ "$PARENT_DEV" != "$SD_DEV" ]]; then
	die "$ROOTFS_PART: parent is $PARENT_DEV, expected $SD_DEV"
fi

printf 'create rootfs on %s\n' "$ROOTFS_PART"
mkfs.ext4 "$ROOTFS_PART" -L rootfs -d "$ROOTFS"
sync

printf 'write bootloader: %s\n' "$BOOTLOADER"
dd if="$FLASH_BOOTLOADER" of="$SD_DEV" seek=16 bs=512
printf 'write opensbi: %s\n' "$OPENSBI"
dd if="$FLASH_OPENSBI" of="$SD_DEV" seek=200 bs=512
printf 'write early dtb: %s\n' "$EARLY_DTB"
dd if="$FLASH_EARLY_DTB" of="$SD_DEV" seek=500 bs=512
printf 'write uboot: %s\n' "$UBOOT"
dd if="$FLASH_UBOOT" of="$SD_DEV" seek=600 bs=512

sync
